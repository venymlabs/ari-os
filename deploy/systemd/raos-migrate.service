[Unit]
Description=Robinhood Agent OS schema migration
Before=raos-api.service

[Service]
Type=oneshot
User=raos
Group=raos
WorkingDirectory=/opt/robinhood-agent-os
EnvironmentFile=/etc/raos/raos.env
StateDirectory=raos
ExecStart=/usr/bin/npm run db:migrate
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/raos
