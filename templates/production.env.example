# Copy to a root-owned mode-0600 environment file. Never commit real values.
RPC_URL=https://your-authenticated-rpc.example
NETWORK=mainnet
EXECUTION_MODE=dry-run
# The base58 Ed25519 public key of the dedicated signing wallet.
TRADING_ACCOUNT=
TRADING_MAX_AMOUNT_IN=
# Base-unit cap applied independently to every mint in TRADING_ALLOWED_TOKENS.
# Values for mints with different decimals are never added together. Aggregate
# exposure remains disabled unless a single quote denomination plus explicit
# decimals and price/valuation evidence are configured by the production adapter.
# Comma-separated base58 mints.
TRADING_ALLOWED_TOKENS=
API_BEARER_TOKEN_SHA256=replace_with_64_hex_sha256
API_SCOPES=agent:read,agent:write,tool:read,tool:invoke,simulation:invoke
