# Point the console at a live ARI OS control plane.
#
# Unset (the default): the app runs the in-browser simulation in
# `src/data/fixture-source.ts` and the rail reads SOURCE · SIMULATED, so a
# simulation is never mistaken for a funded wallet.
#
# Set: the app talks REST + SSE to the endpoints documented at the top of
# `src/data/http-source.ts`.
# VITE_ARI_API=http://127.0.0.1:8787/api
