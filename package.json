{
  "name": "robinhood-agent-os",
  "version": "0.1.0",
  "description": "Production-capable Solana agent runtime with policy controls and an isolated signer",
  "private": false,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "bin": {
    "raos": "dist/bin/robinhood-agent-os.js",
    "raos-telegram": "dist/bin/telegram.js",
    "raos-signer": "dist/bin/signer.js"
  },
  "files": [
    "dist",
    "web/dist",
    "README.md",
    "docs",
    "compose.yaml",
    "deploy",
    "templates",
    "LICENSE",
    "NOTICE",
    "licenses",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/*.integration.test.ts",
    "test:integration": "vitest run tests/*.integration.test.ts",
    "test:smoke": "npm run smoke:composition",
    "lint": "eslint src tests && npm run typecheck",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "verify": "npm run build && npm run test && npm run lint && npm run format:check",
    "prepublishOnly": "npm run verify",
    "config:check": "node dist/bin/maintenance.js config",
    "db:migrate": "node dist/bin/maintenance.js db:migrate",
    "db:status": "node dist/bin/maintenance.js db:status",
    "db:integrity": "node dist/bin/maintenance.js db:integrity",
    "db:check": "npm run db:integrity",
    "smoke:composition": "npm run build --silent && node dist/bin/smoke-composition.js",
    "start": "node dist/server.js",
    "dev": "npm run build --silent && node --watch dist/server.js",
    "cli": "node dist/bin/robinhood-agent-os.js",
    "worker": "node dist/bin/worker.js",
    "telegram": "node dist/bin/telegram.js",
    "signer": "node dist/bin/signer.js",
    "setup:trading": "node dist/bin/robinhood-agent-os.js setup",
    "trading:reconcile": "node dist/bin/robinhood-agent-os.js trade reconcile",
    "dashboard:build": "npm --prefix web ci && npm --prefix web run build"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "fastify": "^5.10.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "peerDependencies": {
    "@drift-labs/sdk": "^2.156.0",
    "@meteora-ag/dlmm": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@drift-labs/sdk": {
      "optional": true
    },
    "@meteora-ag/dlmm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.15.0",
    "eslint": "10.7.0",
    "prettier": "3.9.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.64.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venymlabs/ari-os.git"
  },
  "homepage": "https://github.com/venymlabs/ari-os#readme",
  "bugs": {
    "url": "https://github.com/venymlabs/ari-os/issues"
  },
  "keywords": [
    "agent",
    "trading",
    "solana",
    "signer",
    "autonomous"
  ],
  "author": "Venym Labs"
}
