# Safe defaults; copy and override per process.
NODE_ENV=test
DATA_DIR=/tmp/raos-state
NETWORK=testnet
EXECUTION_MODE=read-only
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=30000
# Mainnet requires BOTH values below; intentionally disabled.
MAINNET_ENABLED=false
MAINNET_ACKNOWLEDGE_RISK=
# Provider/RPC references (never private keys)
ROBINHOOD_TESTNET_RPC_URL=
BLOCKSCOUT_URL=
MODEL_BASE_URL=
MODEL_API_KEY_REF=
API_AUTH_SECRET_REF=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN_REF=
TELEGRAM_ALLOWLIST=
